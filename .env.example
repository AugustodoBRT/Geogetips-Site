# ---------------------------------------------------------------------------
# NADA AQUI É OBRIGATÓRIO.
# A planilha do grupo é pública, e o site a lê por leitura anônima.
# As variáveis abaixo só existem para casos específicos.
# ---------------------------------------------------------------------------

# Outra planilha que não a padrão do grupo.
GOOGLE_SPREADSHEET_ID=

# Planilha do GeogeTips - Sigma, o grupo pago. Enquanto estiver vazia, o
# site oferece só o grupo gratuito. Mesmo formato da planilha do gratuito.
GOOGLE_SPREADSHEET_ID_SIGMA=

# Página do GeogeTips - Sigma na prop.ag. Enquanto estiver vazia, o link da
# lista de espera não aparece.
NEXT_PUBLIC_SIGMA_URL=

# Service account. Só é necessária se a planilha deixar de ser pública.
# Cole o JSON inteiro em UMA linha.
GOOGLE_SERVICE_ACCOUNT_JSON=

# URL pública do site — usada em og:image e metadataBase
NEXT_PUBLIC_SITE_URL=https://geogetips.vercel.app

# Modo demonstração: dados fictícios COM aviso visível na tela.
# Nunca é ativado automaticamente por falha de leitura.
NEXT_PUBLIC_USE_MOCK=0
